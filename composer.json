{
  "name": "perspective/module-observability-otel",
  "description": "Optional OpenTelemetry integration for Magento 2",
  "type": "magento2-module",
  "require": {
    "cweagans/composer-patches": "^2.0",
    "ext-opentelemetry": "^1.4",
    "magento/framework": "^103.0",
    "magento/framework-amqp": "^100.4",
    "magento/framework-message-queue": "^100.4",
    "magento/module-cron": "^100.4",
    "nyholm/psr7-server": "^1.1",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/opentelemetry-auto-curl": "^0.1",
    "open-telemetry/opentelemetry-auto-magento2": "0.1.0",
    "open-telemetry/opentelemetry-auto-pdo": "^0.2",
    "open-telemetry/sdk": "^1.12",
    "perspective/module-observability": "^1.0",
    "php": ">=8.3 <8.6",
    "php-http/guzzle7-adapter": "^1.1"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Perspective\\ObservabilityOtel\\": ""
    }
  },
  "license": "proprietary",
  "homepage": "https://github.com/perspectiveteamcom/magento2-observability-otel",
  "support": {
    "issues": "https://github.com/perspectiveteamcom/magento2-observability-otel/issues",
    "source": "https://github.com/perspectiveteamcom/magento2-observability-otel"
  },
  "conflict": {
    "perspective/module-observability-compat": "*"
  },
  "suggest": {
    "ext-protobuf": "Faster OTLP serialization",
    "ext-excimer": "CPU profiles when enabled in the project environment"
  },
  "extra": {
    "patches": {
      "open-telemetry/opentelemetry-auto-magento2": [
        {
          "description": "Accept Magento response interfaces and finalize REST status after sendResponse",
          "url": "https://raw.githubusercontent.com/perspectiveteamcom/magento2-observability-otel/v2.0.0/patches/magento2-http-response-interface.patch",
          "sha256": "a655d67dece35a8a0105995a0840dc830511a612468c72324487a6da908a5d9f",
          "depth": 1
        }
      ]
    }
  }
}
