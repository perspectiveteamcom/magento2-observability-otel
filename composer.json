{
  "name": "perspective/module-observability-otel",
  "description": "OpenTelemetry integration package for Magento 2 applications with complete observability stack",
  "type": "magento2-module",
  "license": "MIT",
  "authors": [
    {
      "name": "Mumzworld Development Team",
      "email": "dev@mumzworld.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "magento/framework": "^103.0",
    "open-telemetry/api": "^1.2",
    "open-telemetry/exporter-otlp": "^1.2",
    "open-telemetry/sdk": "^1.2",
    "open-telemetry/sem-conv": "^1.30",
    "ext-opentelemetry": "*"
  },
  "autoload": {
    "psr-4": {
      "Mumzworld\\OpenTelemetry\\": "src/"
    },
    "files": [
      "registration.php",
      "_register.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "homepage": "https://github.com/perspectiveteamcom/magento2-observability-otel",
  "support": {
    "source": "https://github.com/perspectiveteamcom/magento2-observability-otel",
    "issues": "https://github.com/perspectiveteamcom/magento2-observability-otel/issues"
  }
}
